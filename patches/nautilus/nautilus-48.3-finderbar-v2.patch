+static void
+finder_bar_update_zoom (NautilusFilesView *self)
+{
+    NautilusFilesViewPrivate *priv = nautilus_files_view_get_instance_private (self);
+
+    if (priv->finder_zoom_scale == NULL || priv->list_base == NULL)
+    {
+        return;
+    }
+
+    NautilusViewInfo view_info = nautilus_list_base_get_view_info (priv->list_base);
+    gint zoom_level = nautilus_list_base_get_zoom_level (priv->list_base);
+    gboolean supported = view_info.zoom_level_min < view_info.zoom_level_max;
+
+    priv->finder_zoom_syncing = TRUE;
+    gtk_range_set_range (GTK_RANGE (priv->finder_zoom_scale),
+                         view_info.zoom_level_min,
+                         view_info.zoom_level_max);
+    gtk_range_set_increments (GTK_RANGE (priv->finder_zoom_scale), 1, 1);
+    gtk_range_set_round_digits (GTK_RANGE (priv->finder_zoom_scale), 0);
+    gtk_range_set_value (GTK_RANGE (priv->finder_zoom_scale), zoom_level);
+    priv->finder_zoom_syncing = FALSE;
+
+    gtk_widget_set_sensitive (priv->finder_zoom_scale, supported);
+}
+
+static void
+finder_bar_update (NautilusFilesView *self)
+{
+    NautilusFilesViewPrivate *priv = nautilus_files_view_get_instance_private (self);
+    g_autolist (NautilusFile) selection = NULL;
+    g_autofree gchar *items_text = NULL;
+    g_autofree gchar *free_space = NULL;
+    guint total = 0;
+    guint selected = 0;
+    guint64 selected_size = 0;
+    gboolean selected_size_known = TRUE;
+
+    if (priv->finder_items_label == NULL)
+    {
+        return;
+    }
+
+    if (priv->model != NULL)
+    {
+        total = g_list_model_get_n_items (G_LIST_MODEL (priv->model));
+        selection = nautilus_view_get_selection (NAUTILUS_VIEW (self));
+        selected = g_list_length (selection);
+    }
+
+    if (selected == 0)
+    {
+        items_text = g_strdup_printf (ngettext ("%'u item", "%'u items", total), total);
+    }
+    else
+    {
+        items_text = g_strdup_printf (ngettext ("%'u of %'u item selected",
+                                                "%'u of %'u items selected",
+                                                selected),
+                                      selected, total);
+
+        for (GList *l = selection; l != NULL; l = l->next)
+        {
+            NautilusFile *file = l->data;
+
+            if (nautilus_file_is_directory (file) || nautilus_file_can_get_size (file))
+            {
+                selected_size_known = FALSE;
+                break;
+            }
+            selected_size += nautilus_file_get_size (file);
+        }
+
+        if (selected_size_known)
+        {
+            g_autofree gchar *size = g_format_size (selected_size);
+            gchar *with_size = g_strdup_printf ("%s — %s", items_text, size);
+
+            g_free (items_text);
+            items_text = with_size;
+        }
+    }
+
+    gtk_label_set_text (GTK_LABEL (priv->finder_items_label), items_text);
+
+    if (priv->directory_as_file != NULL)
+    {
+        /* This existing Nautilus API is cached, rate-limited and asynchronous.
+         * Its completion emits ::changed, which schedules the next update. */
+        free_space = nautilus_file_get_volume_free_space (priv->directory_as_file);
+    }
+    gtk_label_set_text (GTK_LABEL (priv->finder_free_space_label),
+                        free_space != NULL ? free_space : "");
+
+    finder_bar_update_zoom (self);
+}
+
+static void
+finder_zoom_value_changed (GtkRange          *range,
+                           NautilusFilesView *self)
+{
+    NautilusFilesViewPrivate *priv = nautilus_files_view_get_instance_private (self);
+
+    if (priv->finder_zoom_syncing || priv->list_base == NULL)
+    {
+        return;
+    }
+
+    NautilusViewInfo view_info = nautilus_list_base_get_view_info (priv->list_base);
+    gint requested = CLAMP ((gint) gtk_range_get_value (range),
+                            view_info.zoom_level_min,
+                            view_info.zoom_level_max);
+
+    if (requested != nautilus_list_base_get_zoom_level (priv->list_base))
+    {
+        nautilus_list_base_set_zoom_level (priv->list_base, requested);
+        update_zoom_actions_state (self);
+    }
+}
+
+static void
+finder_zoom_notify (GObject            *object,
+                    GParamSpec         *pspec,
+                    NautilusFilesView *self)
+{
+    (void) object;
+    (void) pspec;
+    finder_bar_update_zoom (self);
+}
+
+static void
+finder_model_items_changed (GListModel        *model,
+                            guint              position,
+                            guint              removed,
+                            guint              added,
+                            NautilusFilesView *self)
+{
+    (void) model;
+    (void) position;
+    (void) removed;
+    (void) added;
+    finder_bar_update (self);
+}
