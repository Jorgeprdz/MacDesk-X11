#!/data/data/com.termux/files/usr/bin/bash
set -u
HOME="${HOME:-/data/data/com.termux/files/home}"
STATE="$HOME/.local/state/macdesk-v3"
QUIET="${1:-}"
stop_pid() {
  f="$1"
  if [ -f "$f" ]; then
    p="$(cat "$f" 2>/dev/null)"
    if [ -n "${p:-}" ]; then kill "$p" 2>/dev/null || true; sleep 1; kill -9 "$p" 2>/dev/null || true; fi
    rm -f "$f"
  fi
}
stop_pid "$STATE/session.pid"
pkill -x xfce4-session 2>/dev/null || true
pkill -x xfwm4 2>/dev/null || true
pkill -x xfce4-panel 2>/dev/null || true
pkill -x xfdesktop 2>/dev/null || true
stop_pid "$STATE/x11.pid"
pkill -x termux-x11 2>/dev/null || true
am broadcast -a com.termux.x11.ACTION_STOP -p com.termux.x11 >/dev/null 2>&1 || true
rm -f "$STATE/running"
[ "$QUIET" = "--quiet" ] || echo "✅ MacDesk V3 detenido"
