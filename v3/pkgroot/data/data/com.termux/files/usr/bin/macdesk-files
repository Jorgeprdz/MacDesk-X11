#!/data/data/com.termux/files/usr/bin/bash
set -u
if command -v proot-distro >/dev/null 2>&1 && proot-distro list 2>/dev/null | grep -q 'debian'; then
  NAU="$(proot-distro login debian --user desktop -- bash -lc 'command -v nautilus' 2>/dev/null | tail -1)"
  if [ -n "$NAU" ]; then exec proot-distro login debian --user desktop --shared-tmp -- env DISPLAY=:1 PULSE_SERVER=127.0.0.1 "$NAU" "$@"; fi
fi
if command -v thunar >/dev/null 2>&1; then exec thunar "$@"; fi
echo "No hay gestor de archivos disponible."
