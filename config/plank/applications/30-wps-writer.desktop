[Desktop Entry]
Type=Application
Name=WPS Writer
Comment=Documents with WPS Office
Icon=macdesk-wps-writer
Exec=/root/MacDesk-V6/scripts/launch-wps writer %F
TryExec=/root/MacDesk-V6/scripts/launch-wps
StartupWMClass=wps
Terminal=false
NoDisplay=false
Categories=Office;WordProcessor;
MimeType=application/msword;application/vnd.openxmlformats-officedocument.wordprocessingml.document;application/rtf;text/plain;
