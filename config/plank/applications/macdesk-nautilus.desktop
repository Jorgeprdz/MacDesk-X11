[Desktop Entry]
Version=1.0
Type=Application
Name=Files
GenericName=File Manager
Comment=Browse MacDesk and Android storage
Exec=/root/MacDesk-V6/scripts/dock-open-or-focus files
TryExec=/usr/local/bin/macdesk-nautilus
Icon=/root/MacDesk-V6/assets/icons/dock/finder.svg
Terminal=false
StartupNotify=false
StartupWMClass=org.gnome.Nautilus
NoDisplay=true
Categories=System;FileTools;FileManager;
MimeType=inode/directory;
