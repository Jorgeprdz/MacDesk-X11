# Persistent known-good Samsung DeX keyboard contract. scripts/macdesk applies
# the same values without force-stopping the shared Termux/Termux:X11 UID.
dexMetaKeyCapture=false
enableAccessibilityServiceAutomatically=false
pointerCapture=false
hardwareKbdScancodesWorkaround=true
preferScancodes=true
filterOutWinkey=false
pauseKeyInterceptingWithEsc=true
enforceCharBasedInput=false

# Alt+Tab takes priority. Super remains outside this acceptance gate.
SUPER_AVAILABLE=false
NO_STUCK_MODIFIER=true
ALT_TAB_CONFIG=PASS
