/* WhatsApp dedicated profile: keep browser controls visible enough to expose window buttons. */
#PersonalToolbar {
  visibility: collapse !important;
}

#TabsToolbar {
  visibility: visible !important;
}

#nav-bar {
  visibility: visible !important;
  min-height: 32px !important;
}

#navigator-toolbox {
  min-height: 32px !important;
}
