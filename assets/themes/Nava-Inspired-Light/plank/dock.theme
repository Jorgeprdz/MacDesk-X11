# Original MacDesk Nava-inspired Plank design; no Nava OS code or imagery.
[PlankTheme]
TopRoundness=26
BottomRoundness=26
LineWidth=1
OuterStrokeColor=255;;255;;255;;145
FillStartColor=232;;243;;252;;183
FillEndColor=187;;211;;232;;194
InnerStrokeColor=255;;255;;255;;122
[PlankDockTheme]
HorizPadding=3
TopPadding=3
BottomPadding=3
ItemPadding=4
IndicatorSize=5
IconShadowSize=0
UrgentBounceHeight=2
LaunchBounceHeight=0.7
FadeOpacity=1
ClickTime=260
UrgentBounceTime=0
LaunchBounceTime=500
ActiveTime=220
SlideTime=130
FadeTime=220
HideTime=200
GlowSize=0
GlowTime=0
GlowPulseTime=0
UrgentHueShift=150
ItemMoveTime=180
CascadeHide=true
BadgeColor=49;;155;;232;;220
