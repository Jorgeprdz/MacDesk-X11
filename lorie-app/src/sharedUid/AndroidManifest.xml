<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:sharedUserId="com.termux"
    tools:ignore="Deprecated">
    <application>
        <!-- Keeps termux-x11's process from being classified separately from termux's own cpuset. -->
        <activity android:name="com.termux.x11.MainActivity" android:process="com.termux" />
        <activity android:name="com.termux.x11.LoriePreferences" android:process="com.termux" />
        <receiver android:name="com.termux.x11.LorieBroadcastReceiver" android:process="com.termux" />
        <receiver android:name="com.termux.x11.LoriePreferences$Receiver" android:process="com.termux" />
        <!-- KeyInterceptor exchanges focus and pressed-key state with MainActivity
             through process-local static state. Keep both components together in
             the sharedUid build or Android will enable the service without ever
             forwarding reserved DeX shortcuts such as Alt+Tab. -->
        <service android:name="com.termux.x11.utils.KeyInterceptor" android:process="com.termux" />
    </application>
</manifest>
