+void Group::bounceLaunch()
+{
+    mBounceStart = 0;
+    if (mBounceTick) return;
+    mBounceTick = gtk_widget_add_tick_callback(mButton,
+        +[](GtkWidget*, GdkFrameClock* clock, gpointer data) -> gboolean {
+            Group* me = static_cast<Group*>(data);
+            gint64 now = gdk_frame_clock_get_frame_time(clock);
+            if (!me->mBounceStart) me->mBounceStart = now;
+            double progress = (now - me->mBounceStart) / 800000.0;
+            if (progress >= 1.0) {
+                me->mBounceOffset = 0.0;
+                me->mBounceTick = 0;
+                gtk_widget_queue_draw(me->mButton);
+                return G_SOURCE_REMOVE;
+            }
+            // Two diminishing jumps, with a pause at the baseline at each landing.
+            me->mBounceOffset = -8.0 * (1.0 - progress * 0.6) * std::abs(std::sin(progress * 2.0 * M_PI));
+            gtk_widget_queue_draw(me->mButton);
+            return G_SOURCE_CONTINUE;
+        }, this, nullptr);
+}
+
+void Group::animateHover(bool hover)
+{
+    mHoverTarget = hover ? 1.25 : 1.0;
+    if (mHoverTick) return;
+    mHoverLastFrame = 0;
+    mHoverTick = gtk_widget_add_tick_callback(mButton,
+        +[](GtkWidget*, GdkFrameClock* clock, gpointer data) -> gboolean {
+            Group* me = static_cast<Group*>(data);
+            gint64 now = gdk_frame_clock_get_frame_time(clock);
+            double elapsed = me->mHoverLastFrame ? std::min(0.05, (now - me->mHoverLastFrame) / 1000000.0) : 0.016;
+            me->mHoverLastFrame = now;
+            double step = elapsed * 1.6;
+            double delta = me->mHoverTarget - me->mHoverScale;
+            if (std::abs(delta) <= step) {
+                me->mHoverScale = me->mHoverTarget;
+                me->resize();
+                me->mHoverTick = 0;
+                return G_SOURCE_REMOVE;
+            }
+            me->mHoverScale += delta > 0 ? step : -step;
+            me->resize();
+            return G_SOURCE_CONTINUE;
+        }, this, nullptr);
+}
