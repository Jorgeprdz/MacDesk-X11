#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

BASE="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
  diagnostics|mode|display|memory|snap|quicklook|open-android|share|storage|android-status|event|status)
    exec "$BASE/scripts/macdesk-smart-host" "$@" ;;
esac
STATE="$BASE/state"
LOGS="$BASE/logs"
DISPLAY_NUM=:2
case "$BASE/" in
  "$HOME/"*) GUEST_RELATIVE="${BASE#"$HOME"/}" ;;
  *) echo "ERROR: MacDesk root must live beneath Termux HOME: $BASE"; exit 1 ;;
esac
GUEST_ROOT="/root/$GUEST_RELATIVE"
PREFIX=/data/data/com.termux/files/usr
TMPDIR="${TMPDIR:-$PREFIX/tmp}"
mkdir -p "$STATE" "$LOGS" "$TMPDIR"
exec >>"$LOGS/macdesk-launcher.log" 2>&1
printf 'MACDESK_ROOT=%s DISPLAY=%s METHOD=proot-distro+dbus-run-session+startxfce4\n' "$BASE" "$DISPLAY_NUM"

. "$BASE/scripts/lib/android-x11.sh"

focus_x11_activity() { x11_focus_activity || true; }

# Start the Termux Android PulseAudio sink and expose it to Debian over localhost.
pulseaudio --start --exit-idle-time=-1 >/dev/null 2>&1 || true
sleep .3
pulse_runtime="$(readlink -f "$HOME/.config/pulse"/*-runtime 2>/dev/null | head -1)"
if [ -S "$pulse_runtime/native" ]; then
  if ! pactl --server="unix:$pulse_runtime/native" list modules short 2>/dev/null | grep -q module-native-protocol-tcp; then
    pactl --server="unix:$pulse_runtime/native" load-module module-native-protocol-tcp auth-anonymous=1 port=4713 >/dev/null 2>&1 || true
  fi
fi

# Enforce the known-good keyboard contract through the safe interface for the
# installed flavor: direct broadcast for sharedUid, companion helper for the
# standalone sandbox.  Neither path enables accessibility interception.
if ! x11_apply_keyboard_preferences; then
  echo "WARNING: X11 keyboard preferences unavailable; continuing with current preferences"
fi

healthy_session() {
  local file="$STATE/session-check.env"
  [ -r "$file" ] || return 1
  for key in X11_SERVER DBUS_SESSION XFCONF XFCE_SESSION XFWM XFCE_PANEL; do
    grep -qx "$key=PASS" "$file" || return 1
  done
}

if [ -f "$STATE/guest.pid" ]; then
  old_guest="$(cat "$STATE/guest.pid" 2>/dev/null || true)"
  case "$old_guest" in (''|*[!0-9]*) old_guest='' ;; esac
  if [ -n "$old_guest" ] && kill -0 "$old_guest" 2>/dev/null; then
    old_cmd="$(tr '\0' ' ' <"/proc/$old_guest/cmdline" 2>/dev/null || true)"
    case "$old_cmd" in
      *"$GUEST_ROOT/scripts/session-start"*|*"$GUEST_ROOT/scripts/macdesk-xfce-session"*|*"$GUEST_ROOT/config/gpu/env.sh"*)
        if healthy_session; then
          focus_x11_activity
          echo 'MACDESK_V6=ALREADY_RUNNING'
          echo 'TERMUX_X11_ACTIVITY=FOCUSED'
          exit 0
        fi
        echo "stopping invalid MacDesk guest wrapper pid=$old_guest cmd=$old_cmd"
        kill -TERM "$old_guest" 2>/dev/null || true
        for _ in $(seq 1 50); do
          kill -0 "$old_guest" 2>/dev/null || break
          sleep .1
        done
        if kill -0 "$old_guest" 2>/dev/null; then
          echo "ERROR: invalid owned session wrapper did not stop pid=$old_guest"
          exit 1
        fi
        rm -f "$STATE/guest.pid" "$STATE/session.pid" "$STATE/session-check.env"
        ;;
      *)
        echo "ERROR: guest.pid points to unrelated process pid=$old_guest cmd=$old_cmd"
        exit 1
        ;;
    esac
  else
    rm -f "$STATE/guest.pid" "$STATE/session.pid" "$STATE/session-check.env"
  fi
fi

x11_existing=''
for proc in /proc/[0-9]*/cmdline; do
  [ -r "$proc" ] || continue
  cmd="$(tr '\0' ' ' < "$proc" 2>/dev/null || true)"
  case "$cmd" in
    *"termux-x11 com.termux.x11 $DISPLAY_NUM "*)
      x11_existing="${proc#/proc/}"
      x11_existing="${x11_existing%/cmdline}"
      break
      ;;
  esac
done
if [ -n "$x11_existing" ]; then
  rm -f "$STATE/x11.pid"
  echo "TERMUX_X11=ADOPTED PID=$x11_existing"
else
  # A crash can leave the X2 socket pathname behind after its listener dies.
  # x11_existing was resolved from live processes above, so it is safe to
  # remove the stale pathname before starting the replacement server.
  [ ! -S "$PREFIX/tmp/.X11-unix/X2" ] || unlink "$PREFIX/tmp/.X11-unix/X2"
  setsid env TMPDIR="$TMPDIR" termux-x11 "$DISPLAY_NUM" -ac >"$LOGS/termux-x11.log" 2>&1 &
  echo $! >"$STATE/x11.pid"
fi
for _ in $(seq 1 50); do
  [ -S "$PREFIX/tmp/.X11-unix/X2" ] && break
  sleep .1
done
[ -S "$PREFIX/tmp/.X11-unix/X2" ] || { echo TERMUX_X11=FAIL; exit 1; }

# SAFE_FALLBACK does not start or force the experimental Zink/Vulkan path.
# Leave an already-running VirGL service untouched for other Termux clients.
echo GPU_PROFILE=SAFE_FALLBACK

focus_x11_activity

# A new guest must publish fresh health; an earlier PASS is not readiness.
rm -f "$STATE/session-check.env" "$STATE/session-health.env"
setsid proot-distro login debian --shared-home --shared-tmp \
  -e DISPLAY="$DISPLAY_NUM" \
  -e MACDESK_ROOT="$GUEST_ROOT" \
  -e GPU_PROFILE=SAFE_FALLBACK \
  -- "$GUEST_ROOT/scripts/macdesk-xfce-session" \
  >"$LOGS/xfce-session.log" 2>&1 &
echo $! >"$STATE/guest.pid"
printf 'GUEST_PID=%s\n' "$(cat "$STATE/guest.pid")"

for _ in $(seq 1 300); do
  if healthy_session; then
    echo TERMUX_X11=PASS
    echo VIRGL=SAFE_FALLBACK
    echo XFCE=PASS
    echo MACDESK_V6=RUNNING
    cat "$STATE/session-check.env"
    exit 0
  fi
  guest_pid="$(cat "$STATE/guest.pid" 2>/dev/null || true)"
  if [ -n "$guest_pid" ] && ! kill -0 "$guest_pid" 2>/dev/null; then
    echo "ERROR: XFCE launcher exited early pid=$guest_pid"
    tail -80 "$LOGS/xfce-session.log" || true
    exit 1
  fi
  sleep .2
done

echo "ERROR: XFCE baseline health check timed out"
cat "$STATE/session-check.env" 2>/dev/null || true
tail -100 "$LOGS/xfce-session.log" || true

echo XFCE=FAIL
exit 1
