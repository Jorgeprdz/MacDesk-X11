#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail
. /data/data/com.termux/files/home/MacDesk-V6/scripts/macdesk-vnc-common

command -v proot-distro >/dev/null 2>&1 || {
  vnc_error 'PROOT_DISTRO_NOT_FOUND'
  exit 1
}
command -v node >/dev/null 2>&1 || {
  vnc_error 'NODE_NOT_FOUND'
  exit 1
}
vnc_ensure_state

if pid="$(vnc_server_pid 2>/dev/null)"; then
  printf '%s\n' "$pid" >"$VNC_PID_FILE"
  chmod 600 "$VNC_PID_FILE"
  vnc_listener_is_exact || {
    vnc_error 'OWNED_PROCESS_HAS_UNSAFE_OR_MISSING_LISTENER'
    exit 1
  }
  vnc_start_input_bridges || {
    vnc_error 'REMOTE_INPUT_BRIDGES_FAILED'
    exit 1
  }
  echo 'MACDESK_VNC=ALREADY_RUNNING'
  echo "VNC_PID=$pid"
  echo "DISPLAY=$VNC_EXPECTED_DISPLAY"
  echo "HOST=$VNC_HOST"
  echo "PORT=$VNC_PORT"
  echo 'WHATSAPP_VNC_INPUT=PASS'
  echo 'CHATGPT_VNC_INPUT=PASS'
  echo 'EXPECTED_DESKTOP=SAME_EXISTING_MACDESK'
  exit 0
fi

lock="$VNC_STATE_DIR/start.lock"
if ! mkdir "$lock" 2>/dev/null; then
  vnc_error 'START_ALREADY_IN_PROGRESS'
  exit 1
fi
trap 'rmdir "$lock" 2>/dev/null || true' EXIT

vnc_debian sh -lc 'command -v X0tigervnc >/dev/null' || {
  vnc_error 'X0TIGERVNC_NOT_FOUND'
  exit 1
}
vnc_password_is_ready || {
  vnc_error 'PASSWORD_FILE_MISSING_OR_NOT_0600'
  exit 1
}
display="$(vnc_detect_display)"
[ "$display" = "$VNC_EXPECTED_DISPLAY" ] || {
  vnc_error "UNEXPECTED_DISPLAY:$display"
  exit 1
}
vnc_display_is_healthy "$display" || {
  vnc_error "DISPLAY_UNHEALTHY:$display"
  exit 1
}
vnc_desktop_stack_is_single || {
  vnc_error 'EXISTING_DESKTOP_STACK_NOT_SINGLE_OR_UNHEALTHY'
  exit 1
}
vnc_second_x_server_absent || {
  vnc_error 'SECOND_X_SERVER_ALREADY_PRESENT'
  exit 1
}
vnc_tailscale_ip_is_present || {
  vnc_error "TAILSCALE_IP_NOT_PRESENT:$VNC_HOST"
  exit 1
}
vnc_port_is_free || {
  vnc_error "PORT_BUSY_OR_UNVERIFIABLE:$VNC_PORT"
  exit 1
}

rm -f "$VNC_PID_FILE" "$VNC_LAUNCHER_PID_FILE"
: >"$VNC_LOG"
chmod 600 "$VNC_LOG"

setsid proot-distro login debian --shared-tmp -- env \
  DISPLAY="$display" \
  XDG_RUNTIME_DIR="$VNC_XDG_RUNTIME_DIR" \
  X0tigervnc \
    -display "$display" \
    -rfbport "$VNC_PORT" \
    -localhost=0 \
    -interface "$VNC_HOST" \
    -UseIPv4=1 \
    -UseIPv6=0 \
    -UseSHM=0 \
    -SecurityTypes VncAuth \
    -PasswordFile "$VNC_PASSWORD_FILE" \
    -AlwaysShared=1 \
    -DisconnectClients=0 \
    -AcceptCutText=0 \
    -SendCutText=0 \
    </dev/null >>"$VNC_LOG" 2>&1 &
launcher_pid="$!"
printf '%s\n' "$launcher_pid" >"$VNC_LAUNCHER_PID_FILE"
chmod 600 "$VNC_LAUNCHER_PID_FILE"

pid=''
for _ in $(seq 1 100); do
  pid="$(vnc_find_server_pid 2>/dev/null || true)"
  if [ -n "$pid" ]; then
    printf '%s\n' "$pid" >"$VNC_PID_FILE"
    chmod 600 "$VNC_PID_FILE"
    vnc_listener_is_exact && break
  fi
  sleep .1
done

if [ -z "$pid" ] || ! vnc_listener_is_exact; then
  [ -z "$pid" ] || vnc_stop_owned_server "$pid" 2>/dev/null || true
  if kill -0 "$launcher_pid" 2>/dev/null; then
    cmd="$(tr '\0' ' ' <"/proc/$launcher_pid/cmdline" 2>/dev/null || true)"
    vnc_cmd_is_owned_launcher "$cmd" && kill -TERM "$launcher_pid" 2>/dev/null || true
  fi
  rm -f "$VNC_PID_FILE" "$VNC_LAUNCHER_PID_FILE"
  vnc_error 'VNC_START_FAILED_OR_BIND_UNSAFE'
  tail -n 12 "$VNC_LOG" 2>/dev/null || true
  exit 1
fi

if ! vnc_start_input_bridges; then
  vnc_stop_input_bridges 2>/dev/null || true
  vnc_stop_owned_server "$pid" 2>/dev/null || true
  if kill -0 "$launcher_pid" 2>/dev/null; then
    cmd="$(tr '\0' ' ' <"/proc/$launcher_pid/cmdline" 2>/dev/null || true)"
    vnc_cmd_is_owned_launcher "$cmd" && kill -TERM "$launcher_pid" 2>/dev/null || true
  fi
  rm -f "$VNC_PID_FILE" "$VNC_LAUNCHER_PID_FILE"
  vnc_error 'REMOTE_INPUT_BRIDGES_FAILED'
  exit 1
fi

echo 'MACDESK_VNC=RUNNING'
echo "VNC_PID=$pid"
echo "DISPLAY=$display"
echo "HOST=$VNC_HOST"
echo "PORT=$VNC_PORT"
echo 'SECURITY=VncAuth'
echo 'TAILSCALE_BIND=PASS'
echo 'LAN_WILDCARD=NO'
echo 'WHATSAPP_VNC_INPUT=PASS'
echo 'CHATGPT_VNC_INPUT=PASS'
echo 'EXPECTED_DESKTOP=SAME_EXISTING_MACDESK'
