#!/bin/sh
set -eu

ROOT="${MACDESK_ROOT:-$(cd -- "$(dirname -- "$0")/.." && pwd)}"
export MACDESK_ROOT="$ROOT"

export DISPLAY="${DISPLAY:-:2}"
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:?launcher must prepare XDG_RUNTIME_DIR before D-Bus}"
export XDG_SESSION_TYPE=x11
export PULSE_SERVER="${PULSE_SERVER:-127.0.0.1:4713}"
export LANG="${LANG:-C.UTF-8}"
unset LC_ALL
export TZ="${TZ:-America/Mexico_City}"

[ -d "$XDG_RUNTIME_DIR" ] || { echo "invalid XDG_RUNTIME_DIR=$XDG_RUNTIME_DIR" >&2; exit 1; }
[ "$(stat -c %a "$XDG_RUNTIME_DIR")" = 700 ] || { echo "XDG_RUNTIME_DIR must be mode 0700" >&2; exit 1; }
[ -n "${DBUS_SESSION_BUS_ADDRESS:-}" ] || { echo "session bus missing" >&2; exit 1; }
mkdir -p "$ROOT/logs" "$ROOT/state"

# Keep Sushi on the same stable software-rendered GTK path as Nautilus. D-Bus
# activation inherits the bus environment rather than the Nautilus client's
# environment, so use a service-specific wrapper instead of changing the whole
# XFCE session.
install -d -m 0755 /root/.local/share/dbus-1/services
install -m 0755 $ROOT/scripts/launch-sushi-previewer \
  /usr/local/bin/macdesk-sushi-previewer
install -m 0644 $ROOT/config/dbus/org.gnome.NautilusPreviewer.service \
  /root/.local/share/dbus-1/services/org.gnome.NautilusPreviewer.service

# Apply only Nautilus keys present in the installed schema. Sushi itself is
# D-Bus activated on demand by Nautilus, so no always-running preview process
# is added to the XFCE session.
if ! $ROOT/scripts/configure-nautilus-preview \
  >$ROOT/logs/nautilus-preview-config.log 2>&1; then
  echo "MacDesk: Nautilus preview configuration failed; continuing XFCE startup" >&2
fi

# Recreate the stable Android-storage view and desktop integration after any
# guest replacement or unclean Android restart.
mkdir -p /mnt /root/.config/gtk-3.0 /root/.config/xfce4/xfconf/xfce-perchannel-xml /root/.config/autostart
mkdir -p /root/.config/gtk-4.0
getent group 1023 >/dev/null 2>&1 || groupadd -g 1023 android_media_rw
id macdesk >/dev/null 2>&1 || useradd -m -u 1000 -g 1023 -s /bin/sh macdesk
install -m 755 $ROOT/scripts/launch-nautilus /usr/local/bin/macdesk-nautilus
install -m 755 $ROOT/scripts/launch-onlyoffice /usr/local/bin/macdesk-onlyoffice
install -m 755 $ROOT/assets/nautilus/macdesk-nautilus-skip-root-delay.so /usr/local/lib/macdesk-nautilus-skip-root-delay.so
[ -e /mnt/s25 ] || ln -s /sdcard /mnt/s25
[ -e /mnt/phone ] || ln -s /sdcard /mnt/phone
[ -e /mnt/home ] || ln -s /root /mnt/home
[ -e /mnt/macdesk ] || ln -s "$ROOT" /mnt/macdesk
[ -e /root/Phone ] || ln -s /sdcard /root/Phone
[ -e /root/MacDesk ] || ln -s "$ROOT" /root/MacDesk
cp $ROOT/config/storage/gtk-bookmarks /root/.config/gtk-3.0/bookmarks
cp $ROOT/config/gtk-4.0/gtk.css /root/.config/gtk-4.0/gtk.css
cp $ROOT/config/gtk-4.0/gtk-dark.css /root/.config/gtk-4.0/gtk-dark.css
cp $ROOT/config/gtk-3.0/libadwaita.css /root/.config/gtk-3.0/libadwaita.css
cp $ROOT/config/gtk-3.0/libadwaita-tweaks.css /root/.config/gtk-3.0/libadwaita-tweaks.css
mkdir -p /home/macdesk/.config/gtk-3.0 /home/macdesk/.config/gtk-4.0
cp $ROOT/config/storage/gtk-bookmarks /home/macdesk/.config/gtk-3.0/bookmarks
cp $ROOT/config/gtk-3.0/* /home/macdesk/.config/gtk-3.0/
cp -a $ROOT/config/gtk-4.0/. /home/macdesk/.config/gtk-4.0/
chown -R 1000:1023 /home/macdesk
cp $ROOT/config/xfce/helpers.rc /root/.config/xfce4/helpers.rc
cp $ROOT/config/xfce/nautilus-helper.desktop /usr/share/xfce4/helpers/nautilus.desktop
cp $ROOT/config/xfce/firefox-browser-helper.desktop /usr/share/xfce4/helpers/firefox-macdesk.desktop
cp $ROOT/config/xfce/chromium-helper.desktop /usr/share/xfce4/helpers/chromium.desktop
if [ ! -s /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml ]; then
  cp $ROOT/config/xfce/xfce4-session.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-session.xml
fi
if [ ! -s /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml ]; then
  cp $ROOT/config/xfce/xfce4-panel.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-panel.xml
fi
# The repository wallpaper is a first-start default.  Preserve whatever the
# user selects in XFCE on every later MacDesk restart.
if [ ! -s /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml ]; then
  cp $ROOT/config/xfce/xfce4-desktop.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml
fi
if [ ! -s /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml ]; then
  cp $ROOT/config/xfce/xfwm4.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml
fi
if [ ! -s /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml ]; then
  cp $ROOT/config/xfce/xsettings.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml
fi
# The installed theme is named WhiteSur-MacDesk; the former WhiteSur value had
# no matching theme directory and caused inconsistent fallback icons.
icon_theme=WhiteSur-MacDesk
if [ -r /root/.config/macdesk/icon-theme ]; then
  IFS= read -r chosen_icons < /root/.config/macdesk/icon-theme || chosen_icons=
  case "$chosen_icons" in
    BigSur|BigSur-dark)
      [ ! -f "/root/.local/share/icons/$chosen_icons/index.theme" ] || icon_theme="$chosen_icons"
      ;;
  esac
fi
xfconf-query -c xsettings -p /Net/IconThemeName -s "$icon_theme" >/dev/null 2>&1 || \
  xfconf-query -c xsettings -p /Net/IconThemeName -n -t string -s "$icon_theme" >/dev/null 2>&1
rm -f /root/.config/autostart/cairo-dock.desktop
cp $ROOT/config/autostart/plank.desktop /root/.config/autostart/plank.desktop
mkdir -p /usr/local/share/icons
if [ ! -e /usr/local/share/icons/Cupertino-Sonoma ]; then
  ln -s $ROOT/vendor/visual-sources/Cupertino-Sonoma-iCons /usr/local/share/icons/Cupertino-Sonoma
fi
mkdir -p /root/.local/share/icons
if [ ! -e /root/.local/share/icons/WhiteSur-MacDesk ]; then
  ln -s $ROOT/assets/icons-clean/WhiteSur-MacDesk /root/.local/share/icons/WhiteSur-MacDesk
fi
mkdir -p /usr/local/share/themes /root/.local/share/themes
for theme in GoldenGate-Light GoldenGate-Dark; do
  link="/root/.local/share/themes/$theme"
  if [ ! -e "$link" ] && [ ! -L "$link" ]; then
    ln -s "$ROOT/assets/themes/$theme" "$link"
  fi
done
if [ -d "$ROOT/vendor/visual-sources/GNOME-macOS-Tahoe/gtk/Tahoe-Dark" ] && [ ! -e /usr/local/share/themes/Tahoe-Dark ] && [ ! -L /usr/local/share/themes/Tahoe-Dark ]; then
  ln -s "$ROOT/vendor/visual-sources/GNOME-macOS-Tahoe/gtk/Tahoe-Dark" /usr/local/share/themes/Tahoe-Dark
fi
if [ -d "$ROOT/config/xfwm/MacDesk-GoldenGate" ] && [ ! -e /usr/local/share/themes/MacDesk-GoldenGate ] && [ ! -L /usr/local/share/themes/MacDesk-GoldenGate ]; then
  ln -s "$ROOT/config/xfwm/MacDesk-GoldenGate" /usr/local/share/themes/MacDesk-GoldenGate
fi
# Keep package-owned Nautilus/ONLYOFFICE menu entries untouched. MacDesk copies
# separate NoDisplay=true helper launchers solely for Plank.
plank_config=/root/.config/plank/dock1
plank_launchers="$plank_config/launchers"
plank_themes=/root/.local/share/plank/themes
mkdir -p "$plank_launchers" "$plank_themes" /root/.local/share/applications
rm -f \
  /root/.local/share/applications/10-nautilus.desktop \
  /root/.local/share/applications/org.gnome.Nautilus.desktop \
  /root/.local/share/applications/onlyoffice-desktopeditors.desktop \
  /root/.local/share/applications/onlyoffice-macdesk.desktop \
  /root/.local/share/applications/onlyoffice-document.desktop \
  /root/.local/share/applications/onlyoffice-spreadsheet.desktop \
  /root/.local/share/applications/onlyoffice-presentation.desktop \
  /root/.local/share/applications/macdesk-onlyoffice-document.desktop \
  /root/.local/share/applications/macdesk-onlyoffice-spreadsheet.desktop \
  /root/.local/share/applications/macdesk-onlyoffice-presentation.desktop \
  /root/.local/share/applications/macdesk-nautilus.desktop \
  /root/.local/share/applications/macdesk-onlyoffice.desktop
rm -f "$plank_launchers"/30-onlyoffice-document.dockitem \
      "$plank_launchers"/31-onlyoffice-spreadsheet.dockitem \
      "$plank_launchers"/32-onlyoffice-presentation.dockitem
cp $ROOT/config/plank/applications/*.desktop /root/.local/share/applications/
update-desktop-database /root/.local/share/applications >/dev/null 2>&1 || true
# These launchers are intentionally retired from the curated dock. Removing
# only their live .dockitem files prevents Plank from auto-pinning them again.
for retired in 05-applications 08-desktop 20-zen 27-chatgpt 28-canva 29-google-docs 30-google-sheets 30-chromium 50-libreoffice 60-gnome-software; do
  rm -f "$plank_launchers/$retired.dockitem"
done
for theme in GoldenGate-Light GoldenGate-Dark; do
  mkdir -p "$plank_themes/$theme"
  cp "$ROOT/assets/themes/$theme/plank/dock.theme" "$plank_themes/$theme/dock.theme"
done
for source in $ROOT/config/plank/launchers/*.dockitem; do
  target="$plank_launchers/$(basename "$source")"
  cp "$source" "$target"
done

plank_theme=GoldenGate-Light
if grep -Eq '^ACTIVE_THEME=(macos27-dark|current-dark|dark|tahoe-dark|rollback)$' $ROOT/state/theme.env 2>/dev/null; then
  plank_theme=GoldenGate-Dark
fi
plank_schema=net.launchpad.plank.dock.settings:/net/launchpad/plank/docks/dock1/
if [ ! -e "$plank_config/.macdesk-v6-configured" ]; then
  gsettings set "$plank_schema" alignment center
  gsettings set "$plank_schema" auto-pinning false
  gsettings set "$plank_schema" dock-items "['10-nautilus.dockitem', 'mailspring-macdesk.dockitem', '20-firefox.dockitem', '25-whatsapp.dockitem', '30-onlyoffice.dockitem', '40-terminal.dockitem', '80-lineaindividual.dockitem', '90-trash.dockitem']"
  gsettings set "$plank_schema" hide-mode none
  gsettings set "$plank_schema" icon-size 52
  gsettings set "$plank_schema" items-alignment center
  gsettings set "$plank_schema" lock-items true
  gsettings set "$plank_schema" pinned-only true
  gsettings set "$plank_schema" position bottom
  gsettings set "$plank_schema" show-dock-item false
  gsettings set "$plank_schema" zoom-enabled false
  : > "$plank_config/.macdesk-v6-configured"
fi
# Keep the curated launcher order deterministic without changing Plank's
# geometry, monitor, theme, or visibility preferences.
curated_dock_items="['10-nautilus.dockitem', 'mailspring-macdesk.dockitem', '20-firefox.dockitem', '25-whatsapp.dockitem', '30-onlyoffice.dockitem', '40-terminal.dockitem', '80-lineaindividual.dockitem', '90-trash.dockitem']"
current_dock_items="$(gsettings get "$plank_schema" dock-items)"
[ "$current_dock_items" = "$curated_dock_items" ] || \
  gsettings set "$plank_schema" dock-items "$curated_dock_items"
gsettings set "$plank_schema" pinned-only true
gsettings set "$plank_schema" theme "$plank_theme"

# Record this session and validate the actual shared bus/clients after startxfce4.
printf '%s\n' "$$" >"$ROOT/state/session.pid"
rm -f "$ROOT/state/session-check.env"
{
  printf 'MACDESK_ROOT=%s\nDISPLAY=%s\nHOME=%s\nUSER=%s\nLOGNAME=%s\n' \
    "$ROOT" "$DISPLAY" "$HOME" "$USER" "$LOGNAME"
  printf 'XDG_RUNTIME_DIR=%s\nDBUS_SESSION_BUS_ADDRESS=%s\nGPU_PROFILE=%s\n' \
    "$XDG_RUNTIME_DIR" "$DBUS_SESSION_BUS_ADDRESS" "${MACDESK_GPU_PROFILE:-SAFE_FALLBACK}"
} >"$ROOT/logs/xfce-session-environment.log"

(
  check="$ROOT/state/session-check.env"
  tmp="${check}.tmp.$$"
  attempt=0
  while [ "$attempt" -lt 90 ]; do
    attempt=$((attempt + 1))
    x11=FAIL; dbus=FAIL; xfconf=FAIL; session=FAIL; wm=FAIL; panel=FAIL; settings=FAIL; desktop=FAIL
    timeout 2 xprop -root >/dev/null 2>&1 && x11=PASS
    timeout 2 dbus-send --session --type=method_call --print-reply \
      --dest=org.freedesktop.DBus / org.freedesktop.DBus.ListNames >/dev/null 2>&1 && dbus=PASS
    timeout 2 xfconf-query -c xfce4-panel -l >/dev/null 2>&1 && xfconf=PASS
    pgrep -x xfce4-session >/dev/null 2>&1 && session=PASS
    if pgrep -x xfwm4 >/dev/null 2>&1 && timeout 2 xprop -root _NET_SUPPORTING_WM_CHECK 2>/dev/null | grep -q 'window id'; then wm=PASS; fi
    if pgrep -x xfce4-panel >/dev/null 2>&1 && timeout 2 xdotool search --onlyvisible --class xfce4-panel >/dev/null 2>&1; then panel=PASS; fi
    pgrep -x xfsettingsd >/dev/null 2>&1 && settings=PASS
    pgrep -x xfdesktop >/dev/null 2>&1 && desktop=PASS
    if [ "$x11:$dbus:$xfconf:$session:$wm:$panel" = PASS:PASS:PASS:PASS:PASS:PASS ]; then break; fi
    sleep .5
  done
  paths=PASS
  for path in "$ROOT/scripts/session-start" "$ROOT/config/xfce" "$ROOT/logs" "$ROOT/state"; do
    [ -e "$path" ] || paths=FAIL
  done
  for executable in startxfce4 xfconf-query dbus-send xprop xfwm4 xfce4-panel xdotool; do
    command -v "$executable" >/dev/null 2>&1 || paths=FAIL
  done
  {
    printf 'CHECKED_AT=%s\n' "$(date -Iseconds)"
    printf 'X11_SERVER=%s\nDBUS_SESSION=%s\nXFCONF=%s\nXFCE_SESSION=%s\n' "$x11" "$dbus" "$xfconf" "$session"
    printf 'XFWM=%s\nXFCE_PANEL=%s\nXFSETTINGS=%s\nXFDESKTOP=%s\n' "$wm" "$panel" "$settings" "$desktop"
    printf 'GPU_PROFILE=%s\nMACDESK_ROOT=%s\nPATHS=%s\n' "${MACDESK_GPU_PROFILE:-SAFE_FALLBACK}" "$ROOT" "$paths"
    printf 'DBUS_SESSION_BUS_ADDRESS=%s\n' "$DBUS_SESSION_BUS_ADDRESS"
    printf 'XFCE_SESSION_PID=%s\nXFWM_PID=%s\nXFCE_PANEL_PID=%s\n' \
      "$(pgrep -x xfce4-session | head -1 || true)" "$(pgrep -x xfwm4 | head -1 || true)" \
      "$(pgrep -x xfce4-panel | head -1 || true)"
  } >"$tmp"
  mv "$tmp" "$check"
  if [ "$x11:$dbus:$xfconf:$session:$wm:$panel" != PASS:PASS:PASS:PASS:PASS:PASS ]; then
    printf 'XFCE startup health check failed (attempts=%s)\n' "$attempt" >>"$ROOT/logs/startxfce4.log"
  elif command -v python3 >/dev/null 2>&1 && [ -f "$ROOT/scripts/macdesk-smart" ]; then
    # Optional shared core inherits the authoritative session bus. Its failure
    # never changes the successful desktop health result above.
    python3 "$ROOT/scripts/macdesk-smart" install >/dev/null 2>&1 || true
    exec python3 "$ROOT/scripts/macdesk-smart" core >/dev/null 2>&1
  fi
) &

# Mexican Spanish XKB is static session configuration, unrelated to Android
# Termux:X11 preferences.
setxkbmap -layout latam

# Samsung DeX can emit Super press 133 with Alt release 64. xfsettingsd applies
# XKB after this script begins, so a session guard enforces the documented safe
# interim contract after startup and after later keyboard/DeX reconnections.
$ROOT/scripts/input-guard \
  >$ROOT/logs/input-guard.log 2>&1 &
echo $! > $ROOT/state/input-guard.pid

# Plank caches the first GDK monitor height and does not follow later DeX
# window/RandR resizes.  Restart only the dock after the new root geometry has
# stabilized and only when its bottom edge is demonstrably stale.
$ROOT/scripts/plank-geometry-guard \
  >>$ROOT/logs/plank-geometry-guard.log 2>&1 &
echo $! > $ROOT/state/plank-geometry-guard.pid

# This monitor is launched here, inside dbus-run-session, so its checks use the
# authoritative XFCE bus and X display.  It records multi-signal health only;
# sleeping poll processes and one failed probe never trigger a kill or focus
# change.
$ROOT/scripts/session-health-supervisor \
  >/dev/null 2>&1 &
echo $! > $ROOT/state/health-supervisor.pid

# Plank uses ARGB surfaces for its rounded translucent theme. XFWM remains the
# only compositor; no second compositor or desktop shell is introduced.
xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s true

exec startxfce4 >>"$ROOT/logs/startxfce4.log" 2>&1
