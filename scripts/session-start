#!/usr/bin/env bash
set +e

ROOT="${MACDESK_ROOT:-/root/MacDesk-V6}"
LOG="$ROOT/logs/session-start-fallback.log"
REAL="$ROOT/scripts/session-start.macdesk-original"

mkdir -p "$ROOT/logs" "$ROOT/state"
exec >>"$LOG" 2>&1

echo
echo "===== MacDesk startup $(date) ====="

echo "[A] Intentando arranque normal..."
"$REAL"
RC=$?

if [ "$RC" -eq 0 ]; then
    exit 0
fi

echo "[A] Falló rc=$RC"
echo "[B] Limpiando sesión XFCE..."

pkill -TERM xfce4-session 2>/dev/null || true
pkill -TERM xfwm4 2>/dev/null || true
pkill -TERM xfsettingsd 2>/dev/null || true
pkill -TERM xfce4-panel 2>/dev/null || true
pkill -TERM plank 2>/dev/null || true

sleep 1

rm -rf "$HOME/.cache/sessions/"* 2>/dev/null || true
rm -f \
  "$ROOT/state/session.pid" \
  "$ROOT/state/session-check.env" \
  2>/dev/null || true

export DISPLAY="${DISPLAY:-:2}"
export HOME=/root
export USER=root
export LOGNAME=root
export TMPDIR=/tmp
export XDG_RUNTIME_DIR=/tmp/macdesk-runtime-0
export XDG_CONFIG_HOME=/root/.config
export XDG_CACHE_HOME=/root/.cache
export XDG_DATA_HOME=/root/.local/share
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE
export DESKTOP_SESSION=xfce
export LANG=C.UTF-8
unset LC_ALL

mkdir -p "$XDG_RUNTIME_DIR"
chmod 700 "$XDG_RUNTIME_DIR"

echo "[B] Intentando startxfce4..."
startxfce4
RC=$?

if [ "$RC" -eq 0 ]; then
    exit 0
fi

echo "[C] startxfce4 falló rc=$RC"
echo "[C] Intentando xfce4-session directo..."

exec xfce4-session
