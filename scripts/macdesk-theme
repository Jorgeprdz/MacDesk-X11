#!/bin/sh
set -eu

ROOT="${MACDESK_ROOT:-/data/data/com.termux/files/home/MacDesk-V6}"
mode="${1:-}"
case "$mode" in
  light|current-light|macos27-light) theme=GoldenGate-Light; xfwm=GoldenGate-Light; source=GoldenGate-Light; wallpaper=macos27-light.svg; icon=WhiteSur-MacDesk ;;
  dark|current-dark|macos27-dark)  theme=GoldenGate-Dark;  xfwm=GoldenGate-Dark;  source=GoldenGate-Dark;  wallpaper=macos27-dark.svg; icon=WhiteSur-MacDesk-dark ;;
  tahoe-light) theme=Tahoe-Alt-Light; xfwm=GoldenGate-Light; source=Tahoe-Alt-Light; wallpaper=Tahoe-5k-light.jpg; icon=WhiteSur-MacDesk ;;
  tahoe-dark)  theme=Tahoe-Alt-Dark;  xfwm=GoldenGate-Dark;  source=Tahoe-Alt-Dark;  wallpaper=Tahoe-5k-dark.jpg; icon=WhiteSur-MacDesk-dark ;;
  rollback) theme=GoldenGate-Dark; xfwm=GoldenGate-Dark; source=GoldenGate-Dark; wallpaper=macos27-dark.svg; icon=WhiteSur-MacDesk-dark ;;
  *) echo "Usage: macdesk-theme macos27-light|macos27-dark|current-light|current-dark|tahoe-light|tahoe-dark|rollback" >&2; exit 2 ;;
esac

if [ "$mode" = tahoe-light ] || [ "$mode" = tahoe-dark ]; then
  wallpaper_path="$ROOT/vendor/visual-sources/GNOME-macOS-Tahoe/.config/walls/Tahoe/$wallpaper"
  wallpaper_guest_path="/root/MacDesk-V6/vendor/visual-sources/GNOME-macOS-Tahoe/.config/walls/Tahoe/$wallpaper"
else
  wallpaper_path="$ROOT/assets/wallpapers/$wallpaper"
  wallpaper_guest_path="/root/MacDesk-V6/assets/wallpapers/$wallpaper"
fi
[ -f "$wallpaper_path" ] || { echo "Wallpaper not found: $wallpaper_path" >&2; exit 1; }

rm -rf "$ROOT/config/gtk-4.0"
mkdir -p "$ROOT/config/gtk-4.0"
cp -a "$ROOT/assets/themes/$source/gtk-4.0/." "$ROOT/config/gtk-4.0/"
sed -i "/name=\"ThemeName\"/s/value=\"[^\"]*\"/value=\"$theme\"/" "$ROOT/config/xfce/xsettings.xml"
sed -i "/name=\"IconThemeName\"/s/value=\"[^\"]*\"/value=\"$icon\"/" "$ROOT/config/xfce/xsettings.xml"
sed -i "/name=\"theme\"/s/value=\"[^\"]*\"/value=\"$xfwm\"/" "$ROOT/config/xfce/xfwm4.xml"
sed -i "/name=\"last-image\"/s#value=\"[^\"]*\"#value=\"$wallpaper_guest_path\"#" "$ROOT/config/xfce/xfce4-desktop.xml"
printf 'ACTIVE_THEME=%s\nUPDATED_AT=%s\n' "$mode" "$(date -Iseconds)" > "$ROOT/state/theme.env"

# A deliberate theme switch replaces the XFCE runtime snapshots. Plank reads
# the selected GoldenGate variant from state/theme.env on the next session.
proot-distro login debian --shared-tmp -- sh -lc 'rm -f /root/.config/xfce4/xfconf/xfce-perchannel-xml/xsettings.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfwm4.xml /root/.config/xfce4/xfconf/xfce-perchannel-xml/xfce4-desktop.xml'
"$ROOT/scripts/macdesk-stop"
"$ROOT/scripts/macdesk"
echo "XFWM_THEME=$xfwm"
echo "MACDESK_THEME_${mode}=PASS"
