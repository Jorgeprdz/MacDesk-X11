#!/data/data/com.termux/files/usr/bin/bash
set -euo pipefail

BASE="${HOME}/MacDesk-V6"
[[ -d "$BASE/.git" ]] || { echo "MacDesk checkout not found: $BASE" >&2; exit 1; }

# Refuse to mutate packages if the checked-out repair scripts are syntactically broken.
bash -n "$BASE/scripts/setup-onlyoffice"
sh -n "$BASE/scripts/launch-onlyoffice"
sh -n "$BASE/scripts/launch-nautilus"
sh -n "$BASE/scripts/session-start"

"$BASE/scripts/macdesk-stop" >/dev/null 2>&1 || true

# Never leave the user staring at a bare Termux:X11 canvas if package work
# fails. Once the desktop is stopped, any error below triggers a best-effort
# restart of the existing MacDesk session before the script returns failure.
repair_complete=0
recover_desktop() {
  status=$?
  if [[ "$repair_complete" != 1 ]]; then
    echo "MacDesk repair interrupted (status=$status); attempting desktop recovery..." >&2
    "$BASE/scripts/macdesk" || {
      echo "MacDesk recovery start also failed; recent logs:" >&2
      tail -80 "$BASE/logs/xfce-session.log" 2>/dev/null || true
      tail -80 "$BASE/logs/dbus-session.log" 2>/dev/null || true
    }
  fi
  exit "$status"
}
trap recover_desktop EXIT

proot-distro login debian --shared-home --shared-tmp -- /bin/bash -lc '
set -euo pipefail
export DEBIAN_FRONTEND=noninteractive

apt-get update
apt-get install -y --reinstall nautilus

/root/MacDesk-V6/scripts/setup-onlyoffice --reinstall

# Remove only stale local overrides created during the failed WPS/ONLYOFFICE
# migration. Package-owned launchers under /usr/share/applications stay intact.
rm -f   /root/.local/share/applications/10-nautilus.desktop   /root/.local/share/applications/org.gnome.Nautilus.desktop   /root/.local/share/applications/onlyoffice-desktopeditors.desktop   /root/.local/share/applications/onlyoffice-macdesk.desktop   /root/.local/share/applications/onlyoffice-document.desktop   /root/.local/share/applications/onlyoffice-spreadsheet.desktop   /root/.local/share/applications/onlyoffice-presentation.desktop   /root/.local/share/applications/macdesk-onlyoffice-document.desktop   /root/.local/share/applications/macdesk-onlyoffice-spreadsheet.desktop   /root/.local/share/applications/macdesk-onlyoffice-presentation.desktop   2>/dev/null || true

rm -f /usr/local/bin/macdesk-wps /usr/local/bin/wps-box64-run
rm -f /root/.local/share/applications/*wps*.desktop 2>/dev/null || true
rm -f /root/.config/plank/dock1/launchers/*wps*.dockitem 2>/dev/null || true
rm -rf /root/.cache/menus /root/.cache/xfce4/appfinder 2>/dev/null || true
update-desktop-database /root/.local/share/applications >/dev/null 2>&1 || true
'

# Remove the obsolete host WPS runtime without touching Box64/glibc themselves.
rm -rf "$HOME/.local/wps-x64" "$HOME/.local/share/Kingsoft" "$HOME/.config/Kingsoft" "$HOME/.cache/Kingsoft" 2>/dev/null || true
rm -f "$HOME"/.cache/box64/*wps*.box64 2>/dev/null || true

bash "$BASE/tests/test-office-storage-contract.sh"

"$BASE/scripts/macdesk"

repair_complete=1
trap - EXIT
echo "MACDESK_OFFICE_STORAGE_REPAIR=PASS"
