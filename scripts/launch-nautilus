#!/bin/sh
set -eu

# MacDesk runs Nautilus inside Debian PRoot on the authoritative XFCE/X11
# session. Keep this wrapper deliberately small: package-owned Nautilus stays
# untouched and Plank calls this wrapper through a private desktop entry.
export XDG_SESSION_TYPE="${XDG_SESSION_TYPE:-x11}"
export LANG="${LANG:-C.UTF-8}"
unset LC_ALL

# Stable GTK4 software path for Termux:X11.
export GSK_RENDERER=cairo
export GDK_DISABLE=gl,vulkan
export LIBGL_ALWAYS_SOFTWARE=true
export GTK_A11Y=none
unset LD_LIBRARY_PATH LIBGL_DRIVERS_PATH GALLIUM_DRIVER MESA_GL_VERSION_OVERRIDE VTEST_SOCKET_NAME

# Skip Nautilus' deliberate root-start delay in the PRoot session when the
# MacDesk preload helper is available.
if [ -f /usr/local/lib/macdesk-nautilus-skip-root-delay.so ]; then
  export LD_PRELOAD="/usr/local/lib/macdesk-nautilus-skip-root-delay.so${LD_PRELOAD:+:$LD_PRELOAD}"
fi

# PRoot cannot provide bubblewrap the kernel-visible paths expected by the
# thumbnail sandbox. This keeps thumbnail generation on the already-contained
# MacDesk path.
export SNAP_NAME="${SNAP_NAME:-macdesk-proot}"

# Prefer the XFCE session bus. If that bus is stale, isolate only Nautilus on a
# fresh private bus instead of changing the rest of the desktop session.
if [ "${MACDESK_NAUTILUS_PRIVATE_BUS:-0}" != 1 ] && {
     [ -z "${DBUS_SESSION_BUS_ADDRESS:-}" ] ||
     ! gdbus call --session          --dest org.freedesktop.DBus          --object-path /org/freedesktop/DBus          --method org.freedesktop.DBus.ListNames >/dev/null 2>&1
   }; then
  export MACDESK_NAUTILUS_PRIVATE_BUS=1
  exec dbus-run-session -- "$0" "$@"
fi

export XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
export GTK_DECORATION_LAYOUT='close,minimize,maximize:'

if command -v gsettings >/dev/null 2>&1; then
  gsettings set org.gnome.desktop.wm.preferences button-layout 'close,minimize,maximize:' >/dev/null 2>&1 || true
  gsettings set org.gnome.desktop.interface icon-theme 'WhiteSur-MacDesk' >/dev/null 2>&1 || true
fi

exec /usr/bin/nautilus "$@"
